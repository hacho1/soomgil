<service>
  <id>SoomgilBackend</id>
  <name>Soomgil Backend</name>
  <description>Soomgil production API. Loopback only; Caddy handles HTTPS.</description>
  <executable>%JAVA_HOME%\bin\java.exe</executable>
  <arguments>-jar "%BASE%\..\..\backend\build\libs\backend-0.0.1-SNAPSHOT.jar" --spring.profiles.active=production</arguments>
  <workingdirectory>%BASE%\..\..\backend</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <serviceaccount><username>NT AUTHORITY\LocalService</username></serviceaccount>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="60 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>5 min</stoptimeout>
  <logpath>%BASE%\..\..\runtime\logs</logpath>
  <log mode="roll-by-size"><sizeThreshold>10240</sizeThreshold><keepFiles>5</keepFiles></log>
</service>
