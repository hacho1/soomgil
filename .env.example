# Backend reads the repository-root .env when launched by run-backend.cmd.
# Never place private API keys in VITE_* variables.
PORT=8080
SOOMGIL_TOUR_API_KEY=
# Catalog: initial full import, daily 03:00 Asia/Seoul changes, weekly full refresh.
SOOMGIL_TOUR_SYNC_ENABLED=true
SOOMGIL_TOUR_CATALOG_DAILY_LIMIT=300
# Detail calls share the TourAPI key; budgets below are local safety caps.
SOOMGIL_TOUR_DETAIL_TIMEOUT_MS=3000
SOOMGIL_TOUR_DETAIL_DAILY_LIMIT=400
GOOGLE_CLIENT_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://127.0.0.1:5173/api/auth/naver/callback
SOOMGIL_ADMIN_USERNAME=
SOOMGIL_DEMO_USERS=false
SOOMGIL_SECURE_COOKIES=false
SOOMGIL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Used only with --spring.profiles.active=production. HTTPS origin, no trailing slash.
SOOMGIL_PUBLIC_ORIGIN=
# H2 online backup: daily 04:00 Asia/Seoul; startup catches up after a missed run.
SOOMGIL_BACKUP_ENABLED=true
SOOMGIL_BACKUP_DIRECTORY=../backup/database
# Optional EXISTING private directory on another disk. Use forward slashes on Windows.
SOOMGIL_BACKUP_REPLICA=
SOOMGIL_BACKUP_KEEP=14

# Per-account diary quotas. Existing records are not deleted when limits change.
SOOMGIL_DIARY_MAX_ENTRIES=300
SOOMGIL_DIARY_MAX_BYTES=67108864

# Default database: backend/data/soomgil.mv.db (H2).
# MariaDB requires ALL settings below. Use a dedicated least-privilege account.
# SOOMGIL_DB_URL=jdbc:mariadb://localhost:3306/soomgil
# SOOMGIL_DB_USERNAME=soomgil
# SOOMGIL_DB_PASSWORD=
# SOOMGIL_DB_DRIVER=org.mariadb.jdbc.Driver
# SOOMGIL_DB_PLATFORM=mysql

# Gmail SMTP: use a dedicated sender account and an app password, not its login password.
# Leave credentials empty to disable new email signup/recovery (no verification bypass).
SOOMGIL_SMTP_HOST=smtp.gmail.com
SOOMGIL_SMTP_PORT=587
SOOMGIL_SMTP_USERNAME=
SOOMGIL_SMTP_PASSWORD=
# Optional; defaults to SOOMGIL_SMTP_USERNAME. Use the sender or an approved alias.
SOOMGIL_SMTP_FROM=

# AI and SMS providers remain separate. Google login keys do not send mail.
