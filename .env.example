# SOOMGIL_DB_USERNAME=root
# SOOMGIL_DB_PASSWORD=your-password
# SOOMGIL_DB_DRIVER=org.mariadb.jdbc.Driver

SOOMGIL_TOUR_API_KEY=your-tour-api-key
